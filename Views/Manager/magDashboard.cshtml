@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CaféManager - Dashboard</title>
    <link rel="stylesheet" type="text/css" href="~/css/Manager/magDashboard.css" />
    <style>
        .product-name {
            color: white !important;
        }
        .graph-card {
            grid-column: span 2;
            min-height: 400px; 
        }

        .chart-wrapper {
            height: 350px; 
            position: relative;
        }

        .product-name {
            color: white !important;
        }

        .graph-card {
            grid-column: span 2;
            min-height: 400px;
        }

        .chart-wrapper {
            height: 350px;
            position: relative;
        }

        .monthly-chart-card {
            grid-column: span 3;
            min-height: 500px;
            margin-top: 15px;
        }

        .chart-title {
            font-size: 18px;
            font-weight: bold;
            color: #3A2718;
            margin-bottom: 20px;
        }

        .monthly-chart-wrapper {
            height: 400px;
            position: relative;
        }

        .year-selector {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .year-selector select {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            background: white;
            font-size: 14px;
            color: #333;
        }

        .year-selector label {
            font-weight: 600;
            color: #333;
        }

        .bar-chart-svg {
            width: 100%;
            height: 100%;
        }

        .bar {
            fill: url(#barGradient);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .bar:hover {
            fill: url(#barHoverGradient);
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
        }

        .bar-value-text {
            font-size: 12px;
            font-weight: bold;
            fill: #333;
            text-anchor: middle;
        }

        .axis-text {
            font-size: 12px;
            fill: #666;
        }

        .grid-line {
            stroke: #f0f0f0;
            stroke-width: 1;
            stroke-dasharray: 2,2;
        }

        .monthly-tooltip {
            position: absolute;
            background: rgba(0,0,0,0.8);
            color: white;
            padding: 10px 15px;
            border-radius: 6px;
            font-size: 13px;
            pointer-events: none;
            opacity: 0;
            transform: translateY(-10px);
            transition: all 0.3s ease;
            z-index: 1000;
            white-space: nowrap;
        }

        .monthly-tooltip.show {
            opacity: 1;
            transform: translateY(-20px);
        }

        .loading-spinner {
            display: none;
            text-align: center;
            padding: 20px;
            color: #666;
        }
    </style>
</head>
@using pbl3_QLCF.ViewModels;
@model DashboardMagViewModel
<body>
    @{
        Html.RenderPartial("~/Views/Manager/sharedAll.cshtml");
    }
    <div class="main-content">
        <div class="dashboard-grid">
            <div class="card">
                <div class="card-title">Doanh thu hôm nay</div>
                <div class="card-value">@(Model.todayRevenue.ToString("#,##0").Replace(",", ".")) <span class="card-unit">VND</span></div>
                <div class="card-trend">
                    @if (Model.todayPercent >= 0)
                    {
                        <span style="color: green;">↑ @(Math.Abs(Model.todayPercent))% so với hôm qua</span>
                    }
                    else if (Model.todayPercent < 0)
                    {
                        <span style="color: red;">↓ @(Math.Abs(Model.todayPercent))% so với hôm qua</span>
                    }
                </div>
            </div>
            <div class="card">
                <div class="card-title">Đơn hàng hôm nay</div>
                <div class="card-value">@Model.todayOrder <span class="card-unit">đơn</span></div>
                <div class="card-trend">
                    @if (Model.orderPercent >= 0)
                    {
                        <span style="color: green;">↑ @(Math.Abs(Model.orderPercent))% so với hôm qua</span>
                    }
                    else if (Model.orderPercent < 0)
                    {
                        <span style="color: red;">↓ @(Math.Abs(Model.orderPercent))% so với hôm qua</span>
                    }
                </div>
            </div>
            <div class="card">
                <div class="card-title">Khách hàng mới</div>
                <div class="card-value">@Model.newCustomerCount <span class="card-unit">người</span></div>
                <div class="card-trend">
                    @if (Model.customerPercent >= 0)
                    {
                        <span style="color: green;">↑ @(Math.Abs(Model.customerPercent))% so với tuần trước</span>
                    }
                    else if (Model.customerPercent < 0)
                    {
                        <span style="color: red;">↓ @(Math.Abs(Model.customerPercent))% so với tuần trước</span>
                    }
                </div>
            </div>

            <div class="card graph-card">
                <div class="chart-title">📊 Xu hướng doanh thu</div>
                <div class="chart-wrapper">
                    <svg class="chart-svg" viewBox="0 0 700 300">
                        <defs>
                            <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
                                <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
                            </linearGradient>
                            <linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" style="stop-color:#667eea;stop-opacity:0.6" />
                                <stop offset="100%" style="stop-color:#667eea;stop-opacity:0" />
                            </linearGradient>
                        </defs>

                        <!-- Grid lines -->
                        <g class="grid">
                            <line class="grid-line" x1="80" y1="50" x2="80" y2="220"></line>
                            <line class="grid-line" x1="80" y1="220" x2="620" y2="220"></line>
                            <line class="grid-line" x1="80" y1="50" x2="620" y2="50"></line>
                            <line class="grid-line" x1="80" y1="92.5" x2="620" y2="92.5"></line>
                            <line class="grid-line" x1="80" y1="135" x2="620" y2="135"></line>
                            <line class="grid-line" x1="80" y1="177.5" x2="620" y2="177.5"></line>
                        </g>

                        <polygon class="chart-area" id="chartArea"></polygon>

                        <polyline class="chart-line" id="chartLine"></polyline>

                        <g id="dataPoints"></g>

                        <g id="xAxisLabels"></g>
                    </svg>
                    <div class="tooltip" id="tooltip"></div>
                </div>
            </div>

            <div class="card product-card">
                <div class="card-title">🥤 Sản phẩm bán chạy</div>
                <div class="product-list">
                    @foreach (var item in Model.topSellingProduct)
                    {
                        <div class="product-item">
                            <div class="product-name">@item.productName</div>
                            <div class="product-quantity">@item.quantity</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Monthly Revenue Chart -->
            <div class="card monthly-chart-card">
                <div class="chart-title">📈 Doanh thu theo tháng trong năm</div>
                <div class="year-selector">
                    <label for="yearSelect">Chọn năm:</label>
                    <select id="yearSelect">
                        <option value="2024">2024</option>
                        <option value="2023">2023</option>
                        <option value="2022">2022</option>
                        <option value="2021">2021</option>
                    </select>
                </div>
                <div class="loading-spinner" id="loadingSpinner">Đang tải dữ liệu...</div>
                <div class="monthly-chart-wrapper">
                    <svg class="bar-chart-svg" viewBox="0 0 800 350" id="monthlyChart">
                        <defs>
                            <linearGradient id="barGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" style="stop-color:#4CAF50;stop-opacity:1" />
                                <stop offset="100%" style="stop-color:#45a049;stop-opacity:1" />
                            </linearGradient>
                            <linearGradient id="barHoverGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" style="stop-color:#66BB6A;stop-opacity:1" />
                                <stop offset="100%" style="stop-color:#4CAF50;stop-opacity:1" />
                            </linearGradient>
                        </defs>
                        <g id="monthlyGrid"></g>
                        <g id="monthlyBars"></g>
                        <g id="monthlyXAxis"></g>
                        <g id="monthlyYAxis"></g>
                    </svg>
                    <div class="monthly-tooltip" id="monthlyTooltip"></div>
                </div>
            </div>

            <div class="card orders-card">
                <div class="card-title">Đơn hàng gần đây</div>
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    @foreach (var item in Model.recentOrders)
                    {
                        <tbody>
                            <tr>
                                <td>@item.orderID</td>
                                <td>@item.customerName</td>
                                <td>@item.tongTien</td>
                                <td>@item.status</td>
                            </tr>
                        </tbody>
                    }
                </table>
            </div>
        </div>
    </div>
    <script>
        const revenueData = @Html.Raw(Json.Serialize(Model.revenueTrend.Select(r => new
            {
                day = r.time,
                revenue = r.revenue,
                date = r.date
            })));

        // Global variables
        let monthlyRevenueData = {};

        // ===== UTILITY FUNCTIONS =====
        function formatCurrency(amount) {
            if (amount >= 1000000) {
                return (amount / 1000000).toFixed(1).replace('.0', '') + 'M';
            }
            else if (amount >= 1000) {
                return (amount / 1000).toFixed(0) + 'K';
            }
            return amount.toString();
        }

        function formatFullCurrency(amount) {
            return amount.toLocaleString('vi-VN') + ' VND';
        }

        function calculateYAxisSteps(maxValue) {
            if (maxValue === 0) return [0, 100000, 200000, 300000, 400000, 500000];

            const magnitude = Math.pow(10, Math.floor(Math.log10(maxValue)));
            const normalized = maxValue / magnitude;

            let step;
            if (normalized <= 1) step = 0.2 * magnitude;
            else if (normalized <= 2) step = 0.5 * magnitude;
            else if (normalized <= 5) step = 1 * magnitude;
            else step = 2 * magnitude;

            const steps = [];
            const numSteps = 5;
            const adjustedMax = Math.ceil(maxValue / step) * step;

            for (let i = 0; i <= numSteps; i++) {
                steps.push((adjustedMax / numSteps) * i);
            }

            return steps.reverse();
        }

        function createChart() {
            const maxRevenue = Math.max(...revenueData.map(d => d.revenue));
            const yAxisSteps = calculateYAxisSteps(maxRevenue);
            const maxYValue = yAxisSteps[0];

            const chartHeight = 170;
            const chartWidth = 540;
            const stepX = chartWidth / (revenueData.length - 1);

            updateYAxisAndGrid(yAxisSteps);

            let points = [];
            let areaPoints = [];

            revenueData.forEach((data, index) => {
                const x = 80 + (index * stepX);
                const y = 220 - (data.revenue / maxYValue) * chartHeight;
                points.push(`${x},${y}`);
                areaPoints.push(`${x},${y}`);
            });

            areaPoints.push(`${80 + (revenueData.length - 1) * stepX},220`);
            areaPoints.push('80,220');

            document.getElementById('chartLine').setAttribute('points', points.join(' '));
            document.getElementById('chartArea').setAttribute('points', areaPoints.join(' '));

            createDataPointsAndXLabels(stepX, maxYValue, chartHeight);
        }

        function updateYAxisAndGrid(yAxisSteps) {
            const svg = document.querySelector('.chart-svg');

            const oldGrid = svg.querySelector('.grid');
            const oldYLabels = svg.querySelectorAll('.y-axis-label');

            if (oldGrid) oldGrid.remove();
            oldYLabels.forEach(label => label.remove());

            const grid = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            grid.setAttribute('class', 'grid');

            const mainBorder = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            mainBorder.setAttribute('x', '80');
            mainBorder.setAttribute('y', '50');
            mainBorder.setAttribute('width', '540');
            mainBorder.setAttribute('height', '170');
            mainBorder.setAttribute('fill', 'none');
            mainBorder.setAttribute('stroke', '#e0e0e0');
            mainBorder.setAttribute('stroke-width', '2');
            grid.appendChild(mainBorder);

            yAxisSteps.forEach((value, index) => {
                const y = 50 + (index * (170 / (yAxisSteps.length - 1)));

                const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                line.setAttribute('class', 'grid-line');
                line.setAttribute('x1', '80');
                line.setAttribute('y1', y);
                line.setAttribute('x2', '620');
                line.setAttribute('y2', y);
                line.setAttribute('stroke', '#f0f0f0');
                line.setAttribute('stroke-width', '1');
                line.setAttribute('stroke-dasharray', '2,2');
                grid.appendChild(line);

                const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.setAttribute('x', '70');
                text.setAttribute('y', y + 5);
                text.setAttribute('class', 'axis-text y-axis-label');
                text.setAttribute('text-anchor', 'end');
                text.setAttribute('font-size', '12');
                text.setAttribute('fill', '#666');
                text.textContent = formatCurrency(value);
                svg.appendChild(text);
            });

            revenueData.forEach((data, index) => {
                const x = 80 + (index * (540 / (revenueData.length - 1)));

                const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                line.setAttribute('class', 'grid-line-vertical');
                line.setAttribute('x1', x);
                line.setAttribute('y1', '50');
                line.setAttribute('x2', x);
                line.setAttribute('y2', '220');
                line.setAttribute('stroke', '#f8f8f8');
                line.setAttribute('stroke-width', '1');
                line.setAttribute('stroke-dasharray', '1,1');
                grid.appendChild(line);
            });

            const defs = svg.querySelector('defs');
            svg.insertBefore(grid, defs.nextSibling);
        }

        function createDataPointsAndXLabels(stepX, maxYValue, chartHeight) {
            const dataPointsGroup = document.getElementById('dataPoints');
            const xAxisLabels = document.getElementById('xAxisLabels');

            dataPointsGroup.innerHTML = '';
            xAxisLabels.innerHTML = '';

            revenueData.forEach((data, index) => {
                const x = 80 + (index * stepX);
                const y = 220 - (data.revenue / maxYValue) * chartHeight;

                const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                circle.setAttribute('class', 'chart-point');
                circle.setAttribute('cx', x);
                circle.setAttribute('cy', y);
                circle.setAttribute('r', '5');
                circle.setAttribute('data-index', index);
                circle.setAttribute('fill', '#667eea');
                circle.setAttribute('stroke', '#fff');
                circle.setAttribute('stroke-width', '2');

                circle.addEventListener('mouseenter', (e) => showTooltip(e, data));
                circle.addEventListener('mouseleave', hideTooltip);

                dataPointsGroup.appendChild(circle);

                const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.setAttribute('x', x);
                text.setAttribute('y', 240);
                text.setAttribute('class', 'axis-text');
                text.setAttribute('text-anchor', 'middle');
                text.setAttribute('font-size', '12');
                text.setAttribute('fill', '#666');
                text.setAttribute('font-weight', 'bold');
                text.textContent = data.day;
                xAxisLabels.appendChild(text);

                const dateText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                dateText.setAttribute('x', x);
                dateText.setAttribute('y', 255);
                dateText.setAttribute('class', 'axis-text');
                dateText.setAttribute('text-anchor', 'middle');
                dateText.setAttribute('font-size', '10');
                dateText.setAttribute('fill', '#999');
                dateText.textContent = data.date;
                xAxisLabels.appendChild(dateText);
            });
        }

        function showTooltip(e, data) {
            const tooltip = document.getElementById('tooltip');
            const rect = e.target.getBoundingClientRect();
            const containerRect = document.querySelector('.chart-wrapper').getBoundingClientRect();

            tooltip.innerHTML = `
                <strong>${data.day} (${data.date})</strong><br>
                Doanh thu: ${formatFullCurrency(data.revenue)}
            `;

            tooltip.style.left = (rect.left - containerRect.left) + 'px';
            tooltip.style.top = (rect.top - containerRect.top - 10) + 'px';
            tooltip.classList.add('show');
        }

        function hideTooltip() {
            document.getElementById('tooltip').classList.remove('show');
        }

        function animateChart() {
            const chartLine = document.getElementById('chartLine');
            const chartArea = document.getElementById('chartArea');
            const dataPoints = document.querySelectorAll('.chart-point');

            if (chartLine) {
                const lineLength = chartLine.getTotalLength();
                chartLine.style.strokeDasharray = lineLength;
                chartLine.style.strokeDashoffset = lineLength;
                chartLine.style.animation = 'drawLine 2s ease-in-out forwards';
            }

            if (chartArea) {
                chartArea.style.opacity = '0';
                chartArea.style.animation = 'fadeInArea 1.5s ease-in-out 0.5s forwards';
            }

            dataPoints.forEach((point, index) => {
                point.style.opacity = '0';
                point.style.transform = 'scale(0)';
                point.style.animation = `fadeInPoint 0.5s ease-in-out ${1 + index * 0.1}s forwards`;
            });
        }

        // ===== PEAK HOURS CHART FUNCTIONS =====
        function animatePeakHours() {
            const barFills = document.querySelectorAll('.bar-fill');
            barFills.forEach((bar, index) => {
                const originalHeight = bar.style.height;
                bar.style.height = '0%';
                bar.style.transition = 'height 1s ease-in-out';

                setTimeout(() => {
                    bar.style.height = originalHeight;
                }, 500 + index * 200);
            });
        }

        // ===== MONTHLY CHART FUNCTIONS =====
        function loadMonthlyData(year) {
            document.getElementById('loadingSpinner').style.display = 'block';

            fetch(`/Manager/GetMonthlyRevenue?year=${year}`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
                .then(response => response.json())
                .then(data => {
                    document.getElementById('loadingSpinner').style.display = 'none';

                    if (data.success) {
                        monthlyRevenueData[year] = data.data;
                        createMonthlyChart(year);
                    } else {
                        console.error('Lỗi khi tải dữ liệu:', data.message);
                        showErrorAndFallback(year);
                    }
                })
                .catch(error => {
                    console.error('Lỗi kết nối:', error);
                    document.getElementById('loadingSpinner').style.display = 'none';
                    showErrorAndFallback(year);
                });
        }

        function showErrorAndFallback(year) {
            alert('Không thể tải dữ liệu từ server. Hiển thị dữ liệu mẫu.');

            monthlyRevenueData[year] = [
                { month: 1, revenue: 0, name: 'Tháng 1' },
                { month: 2, revenue: 0, name: 'Tháng 2' },
                { month: 3, revenue: 0, name: 'Tháng 3' },
                { month: 4, revenue: 0, name: 'Tháng 4' },
                { month: 5, revenue: 0, name: 'Tháng 5' },
                { month: 6, revenue: 0, name: 'Tháng 6' },
                { month: 7, revenue: 0, name: 'Tháng 7' },
                { month: 8, revenue: 0, name: 'Tháng 8' },
                { month: 9, revenue: 0, name: 'Tháng 9' },
                { month: 10, revenue: 0, name: 'Tháng 10' },
                { month: 11, revenue: 0, name: 'Tháng 11' },
                { month: 12, revenue: 0, name: 'Tháng 12' }
            ];

            createMonthlyChart(year);
        }

        function createMonthlyChart(year) {
            const data = monthlyRevenueData[year];
            if (!data) return;

            const svg = document.getElementById('monthlyChart');
            const margin = { top: 20, right: 20, bottom: 60, left: 80 };
            const width = 800 - margin.left - margin.right;
            const height = 350 - margin.top - margin.bottom;

            // Clear existing elements
            document.getElementById('monthlyGrid').innerHTML = '';
            document.getElementById('monthlyBars').innerHTML = '';
            document.getElementById('monthlyXAxis').innerHTML = '';
            document.getElementById('monthlyYAxis').innerHTML = '';

            const maxRevenue = Math.max(...data.map(d => d.revenue));
            let yAxisSteps;

            if (maxRevenue === 0) {
                yAxisSteps = [0, 1000000, 2000000, 3000000, 4000000, 5000000];
            } else {
                yAxisSteps = calculateMonthlyYAxisSteps(maxRevenue);
            }

            const maxYValue = yAxisSteps[yAxisSteps.length - 1];

            createMonthlyGrid(yAxisSteps, width, height, margin);

            const barWidth = width / data.length * 0.8;
            const barSpacing = width / data.length;

            data.forEach((item, index) => {
                const barHeight = maxYValue > 0 ? (item.revenue / maxYValue) * height : 0;
                const x = margin.left + (index * barSpacing) + (barSpacing - barWidth) / 2;
                const y = margin.top + height - barHeight;

                const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                rect.setAttribute('class', 'bar');
                rect.setAttribute('x', x);
                rect.setAttribute('y', y);
                rect.setAttribute('width', barWidth);
                rect.setAttribute('height', barHeight);
                rect.setAttribute('data-month', item.month);
                rect.setAttribute('data-revenue', item.revenue);
                rect.setAttribute('data-name', item.name);

                rect.addEventListener('mouseenter', (e) => showMonthlyTooltip(e, item));
                rect.addEventListener('mouseleave', hideMonthlyTooltip);

                document.getElementById('monthlyBars').appendChild(rect);

                if (item.revenue > 0) {
                    const valueText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                    valueText.setAttribute('class', 'bar-value-text');
                    valueText.setAttribute('x', x + barWidth / 2);
                    valueText.setAttribute('y', y - 5);
                    valueText.textContent = formatCurrency(item.revenue);
                    document.getElementById('monthlyBars').appendChild(valueText);
                }

                const monthText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                monthText.setAttribute('class', 'axis-text');
                monthText.setAttribute('x', x + barWidth / 2);
                monthText.setAttribute('y', margin.top + height + 20);
                monthText.setAttribute('text-anchor', 'middle');
                monthText.textContent = `T${item.month}`;
                document.getElementById('monthlyXAxis').appendChild(monthText);
            });

            yAxisSteps.forEach((value, index) => {
                const y = margin.top + height - (index * (height / (yAxisSteps.length - 1)));;

                const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.setAttribute('class', 'axis-text');
                text.setAttribute('x', margin.left - 10);
                text.setAttribute('y', y + 5);
                text.setAttribute('text-anchor', 'end');
                text.textContent = formatCurrency(value);
                document.getElementById('monthlyYAxis').appendChild(text);
            });

            animateMonthlyChart();
        }

        function calculateMonthlyYAxisSteps(maxValue) {
            const step = Math.ceil(maxValue / 5 / 1000000) * 1000000;
            const steps = [];
            for (let i = 0; i <= 5; i++) {
                steps.push(i * step);
            }
            return steps;
        }

        function createMonthlyGrid(yAxisSteps, width, height, margin) {
            const grid = document.getElementById('monthlyGrid');

            const mainBorder = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            mainBorder.setAttribute('x', margin.left);
            mainBorder.setAttribute('y', margin.top);
            mainBorder.setAttribute('width', width);
            mainBorder.setAttribute('height', height);
            mainBorder.setAttribute('fill', 'none');
            mainBorder.setAttribute('stroke', '#e0e0e0');
            mainBorder.setAttribute('stroke-width', '2');
            grid.appendChild(mainBorder);

            yAxisSteps.forEach((value, index) => {
                const y = margin.top + height - (index * (height / (yAxisSteps.length - 1)));;

                const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                line.setAttribute('class', 'grid-line');
                line.setAttribute('x1', margin.left);
                line.setAttribute('y1', y);
                line.setAttribute('x2', margin.left + width);
                line.setAttribute('y2', y);
                grid.appendChild(line);
            });
        }

        function showMonthlyTooltip(e, data) {
            const tooltip = document.getElementById('monthlyTooltip');
            const rect = e.target.getBoundingClientRect();
            const containerRect = document.querySelector('.monthly-chart-wrapper').getBoundingClientRect();

            tooltip.innerHTML = `
                <strong>${data.name}</strong><br>
                Doanh thu: ${formatFullCurrency(data.revenue)}
            `;

            tooltip.style.left = (rect.left - containerRect.left + rect.width / 2) + 'px';
            tooltip.style.top = (rect.top - containerRect.top) + 'px';
            tooltip.classList.add('show');
        }

        function hideMonthlyTooltip() {
            document.getElementById('monthlyTooltip').classList.remove('show');
        }

        function animateMonthlyChart() {
            const bars = document.querySelectorAll('.bar');
            const valueTexts = document.querySelectorAll('.bar-value-text');

            bars.forEach((bar, index) => {
                const originalHeight = bar.getAttribute('height');
                const originalY = bar.getAttribute('y');
                bar.setAttribute('height', '0');
                bar.setAttribute('y', parseFloat(originalY) + parseFloat(originalHeight));

                setTimeout(() => {
                    bar.style.transition = 'all 0.8s ease-out';
                    bar.setAttribute('height', originalHeight);
                    bar.setAttribute('y', originalY);
                }, index * 100);
            });

            valueTexts.forEach((text, index) => {
                text.style.opacity = '0';
                setTimeout(() => {
                    text.style.transition = 'opacity 0.5s ease-in-out';
                    text.style.opacity = '1';
                }, 800 + index * 100);
            });
        }

        function populateYearDropdown() {
            const yearSelect = document.getElementById('yearSelect');
            const currentYear = new Date().getFullYear();

            yearSelect.innerHTML = '';

            for (let year = 2020; year <= currentYear + 1; year++) {
                const option = document.createElement('option');
                option.value = year;
                option.textContent = year;
                if (year === currentYear) {
                    option.selected = true;
                }
                yearSelect.appendChild(option);
            }
        }

        const style = document.createElement('style');
        style.textContent = `
        @@keyframes drawLine {
            to { stroke-dashoffset: 0; }
        }
        @@keyframes fadeInArea {
            to { opacity: 0.3; }
        }
        @@keyframes fadeInPoint {
            to { opacity: 1; transform: scale(1); }
        }
        .chart-point {
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .chart-point:hover {
            r: 7;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
        }
        .tooltip {
            position: absolute;
            background: rgba(0,0,0,0.8);
            color: white;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 12px;
            pointer-events: none;
            opacity: 0;
            transform: translateY(-10px);
            transition: all 0.3s ease;
            z-index: 1000;
            white-space: nowrap;
        }
        .tooltip.show {
            opacity: 1;
            transform: translateY(-20px);
        }

        /* Peak Hours Chart Styles */
        .peak-hours-card {
            grid-column: 1 / -1;
            margin-top: 20px;
        }

        .peak-hours-chart {
            padding: 20px;
        }

        .peak-hours-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }

        .peak-hour-item {
            text-align: center;
            background: #f8f9fa;
            border-radius: 12px;
            padding: 20px 15px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .peak-hour-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

        .time-period {
            font-weight: bold;
            font-size: 16px;
            color: #333;
            margin-bottom: 15px;
        }

        .time-range {
            font-size: 12px;
            color: #666;
            font-weight: normal;
        }

        .chart-bar-container {
            height: 120px;
            display: flex;
            align-items: end;
            justify-content: center;
            margin: 15px 0;
        }

        .chart-bar {
            width: 40px;
            height: 100px;
            background: #e9ecef;
            border-radius: 20px;
            position: relative;
            overflow: hidden;
        }

        .bar-fill {
            position: absolute;
            bottom: 0;
            width: 100%;
            border-radius: 20px;
            transition: height 0.8s ease-in-out;
        }

        .morning .bar-fill {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .afternoon .bar-fill {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }

        .evening .bar-fill {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }

        .night .bar-fill {
            background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        }

        .stats {
            font-size: 14px;
        }

        .orders-count {
            font-weight: bold;
            color: #333;
            margin-bottom: 5px;
        }

        .revenue-amount {
            color: #666;
            font-size: 12px;
        }

        .peak-hours-summary {
            display: flex;
            justify-content: center;
            gap: 40px;
            padding: 20px;
            background: linear-gradient(to right, #6F4E37, #B87333);
            border-radius: 12px;
            color: white;
        }

        .summary-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
        }

        .summary-icon {
            font-size: 18px;
        }

        @@media (max-width: 768px) {
            .peak-hours-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 15px;
            }

            .peak-hours-summary {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }
        }
        `;
        document.head.appendChild(style);

        function initializeCharts() {
            createChart();
            animateChart();
            setTimeout(animatePeakHours, 1000);

            populateYearDropdown();
            const currentYear = new Date().getFullYear();
            document.getElementById('yearSelect').value = currentYear;
            loadMonthlyData(currentYear);

            document.getElementById('yearSelect').addEventListener('change', function () {
                const selectedYear = parseInt(this.value);
                loadMonthlyData(selectedYear);
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeCharts);
        } else {
            initializeCharts();
        }
    </script>
</body>
</html>